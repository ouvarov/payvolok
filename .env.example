NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://payvolok:payvolok@localhost:5432/payvolok
DATABASE_POOL_MAX=10

# required: lowercase SHA-256 hex of the API key, see README
# this one is the hash of local-dev-api-key, local development only
API_KEY_SHA256=2bcd99491790f5324dd084241b713b576a92b12c497f3b553230d49cc72e15c2

# required: where providers reach this API; webhooks go to {PUBLIC_BASE_URL}/webhooks/{provider}
PUBLIC_BASE_URL=http://localhost:3000

# shared by every instance so they verify each other's fake webhooks; at least 32 characters, generate with: openssl rand -hex 32
# unset gives each process its own random secret
# FAKE_WEBHOOK_SECRET=

# Paddle sandbox, see README; each is optional and an empty value counts as unset
# sandbox API key with transaction and adjustment read/write; without it paddle payments answer 503
# PADDLE_API_KEY=pdl_sdbx_apikey_...
# secret of the notification destination <PUBLIC_BASE_URL>/webhooks/paddle; without it paddle webhooks answer 503
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# client-side token for the Paddle.js page at <PUBLIC_BASE_URL>/checkout/paddle; without it the page answers 503
# PADDLE_CLIENT_TOKEN=test_...

# false runs no webhook worker in this process, for an API-only replica
WEBHOOK_WORKER_ENABLED=true
# 100 to 3600000; a delivery wakes the worker at once, so this only paces retries and leftovers
WEBHOOK_POLL_INTERVAL_MS=5000

# false runs no reconciliation worker in this process, for an API-only replica
RECONCILIATION_WORKER_ENABLED=true
# 100 to 3600000; how often due payments are checked with their provider
RECONCILIATION_POLL_INTERVAL_MS=15000

# only for npm run test:e2e; the database must exist and is not the one in DATABASE_URL
E2E_DATABASE_URL=postgres://payvolok:payvolok@localhost:5432/payvolok_e2e
# uncomment for the lock, concurrency and statement timeout e2e tests; needs a real Postgres over a direct connection, not PGlite
# E2E_REAL_POSTGRES=true

# only for npm run db:local
LOCAL_POSTGRES_PORT=55432
