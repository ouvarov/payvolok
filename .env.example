NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://payvolok:payvolok@localhost:5432/payvolok
DATABASE_POOL_MAX=10

# required: where providers reach this API; webhooks go to {PUBLIC_BASE_URL}/webhooks/{provider}/{provider account id}
PUBLIC_BASE_URL=http://localhost:3000

# required: origin of the web app, scheme and host only (no path, no trailing slash); its browser requests pass the CSRF check
WEB_ORIGIN=http://localhost:5173

# shared by every instance so they verify each other's fake webhooks; at least 32 characters, generate with: openssl rand -hex 32
# unset gives each process its own random secret
# FAKE_WEBHOOK_SECRET=

# Paddle sandbox, see README; each is optional and an empty value counts as unset
# sandbox API key with transaction and adjustment read/write; without it paddle payments answer 503
# PADDLE_API_KEY=pdl_sdbx_apikey_...
# secret of the notification destination <PUBLIC_BASE_URL>/webhooks/paddle/<account id>; without it paddle webhooks answer 503
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# client-side token for the Paddle.js page at <PUBLIC_BASE_URL>/checkout/paddle/<account id>; without it the page answers 503
# PADDLE_CLIENT_TOKEN=test_...

# Stripe test mode, see README; each is optional and an empty value counts as unset
# test secret key (sk_test_ or rk_test_); a live key fails boot; without it stripe payments answer 503
# STRIPE_SECRET_KEY=sk_test_...
# signing secret of the webhook destination <PUBLIC_BASE_URL>/webhooks/stripe/<account id>; without it stripe webhooks answer 503
# STRIPE_WEBHOOK_SECRET=whsec_...
# the publishable key (pk_test_...) is not used by the server

# false runs no webhook worker in this process, for an API-only replica
WEBHOOK_WORKER_ENABLED=true
# 100 to 3600000; a delivery wakes the worker at once, so this only paces retries and leftovers
WEBHOOK_POLL_INTERVAL_MS=5000

# false runs no reconciliation worker in this process, for an API-only replica
RECONCILIATION_WORKER_ENABLED=true
# 100 to 3600000; how often due payments are checked with their provider
RECONCILIATION_POLL_INTERVAL_MS=15000

# signs the demoToken of each demo payment; at least 32 characters without spaces, generate with: openssl rand -base64 48
# unset or blank gives each process its own random secret, so tokens die on restart
# DEMO_TOKEN_SECRET=
# demo payments allowed per rolling 24 h across all visitors; 0 turns demo payments off
DEMO_DAILY_PAYMENT_LIMIT=50
# 0 to 5 proxies in front of this API whose X-Forwarded-For entry is trusted; 0 keys the demo rate limit on the socket address
TRUST_PROXY_HOPS=0

# only for npm run test:e2e; the database must exist and is not the one in DATABASE_URL
E2E_DATABASE_URL=postgres://payvolok:payvolok@localhost:5432/payvolok_e2e
# uncomment for the lock, concurrency and statement timeout e2e tests; needs a real Postgres over a direct connection, not PGlite
# E2E_REAL_POSTGRES=true

# only for npm run db:local
LOCAL_POSTGRES_PORT=55432
