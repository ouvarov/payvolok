NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://payvolok:payvolok@localhost:5432/payvolok
DATABASE_POOL_MAX=10

# shared by every instance so they verify each other's fake webhooks; at least 32 characters, generate with: openssl rand -hex 32
# unset gives each process its own random secret
# FAKE_WEBHOOK_SECRET=

# false runs no webhook worker in this process, for an API-only replica
WEBHOOK_WORKER_ENABLED=true
# 100 to 3600000; a delivery wakes the worker at once, so this only paces retries and leftovers
WEBHOOK_POLL_INTERVAL_MS=5000

# only for npm run test:e2e; the database must exist and is not the one in DATABASE_URL
E2E_DATABASE_URL=postgres://payvolok:payvolok@localhost:5432/payvolok_e2e
# uncomment for the lock, concurrency and statement timeout e2e tests; needs a real Postgres over a direct connection, not PGlite
# E2E_REAL_POSTGRES=true

# only for npm run db:local
LOCAL_POSTGRES_PORT=55432
