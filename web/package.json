{
  "name": "payvolok-web",
  "version": "0.0.1",
  "description": "PayVolok live demo page.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run format:check",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.108.2",
    "stylelint": "~17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.3",
    "stylelint-plugin-use-baseline": "^1.4.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
